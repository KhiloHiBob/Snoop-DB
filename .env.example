# Copy to .env and replace both placeholders with different local passwords.
POSTGRES_PASSWORD=replace-with-local-admin-password
SNOOP_DB_PASSWORD=replace-with-local-reader-password
DATABASE_URL='host=localhost port=5432 dbname=snoop user=snoop_reader'
PGPASSWORD=replace-with-local-reader-password
ALLOWED_RELATIONS=public.customers,public.orders,public.order_summary
DB_DIALECT=postgres
LLM_PROVIDER=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
SEND_RESULTS_TO_LLM=false
MAX_ROWS=100
STATEMENT_TIMEOUT_MS=5000
